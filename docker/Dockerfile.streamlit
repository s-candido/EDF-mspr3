FROM python:3.10-slim

WORKDIR /app

# Install required Python packages for the Streamlit dashboard
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    streamlit==1.41.1 \
    pandas==2.2.3 \
    psycopg2-binary==2.9.10 \
    plotly==5.24.1 \
    numpy==1.26.4 \
    openpyxl==3.1.5

# Copy the entire project (the app needs access to src/ui-interface)
COPY . .

# Expose Streamlit default port
EXPOSE 8501

# Health check
HEALTHCHECK CMD curl --fail http://localhost:8501/_stcore/health || exit 1

ENTRYPOINT ["streamlit", "run", "src/ui-interface/streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0"]
