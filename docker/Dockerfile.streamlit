FROM python:3.10-slim

WORKDIR /app

# Install required Python packages for the Streamlit dashboard
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    streamlit==1.41.1 \
    pandas==2.2.3 \
    psycopg2-binary==2.9.10 \
    plotly==5.24.1 \
    numpy==1.26.4 \
    openpyxl==3.1.5

# Copy only the frontend (build context is set to ./frontend in docker-compose)
COPY . .

EXPOSE 8501

HEALTHCHECK CMD curl --fail http://localhost:8501/_stcore/health || exit 1

ENTRYPOINT ["streamlit", "run", "ui-interface/streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0"]
